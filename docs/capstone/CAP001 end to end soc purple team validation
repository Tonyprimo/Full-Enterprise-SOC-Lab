## CORR-002 Implementation

```spl
index=* ((EventCode=4624 AND LogonType=3) OR EventCode=4104)
| where EventCode=4104 OR (EventCode=4624 AND IpAddress!="-" AND IpAddress!="127.0.0.1" AND IpAddress!="::1")
| eval activity=case(EventCode=4624,"network_logon",EventCode=4104,"powershell")
| eval network_time=if(activity="network_logon",_time,null())
| eval network_account=if(activity="network_logon",TargetUserName,null())
| eval network_ip=if(activity="network_logon",IpAddress,null())
| sort 0 host _time
| streamstats last(network_time) as prior_network_time last(network_account) as prior_account last(network_ip) as prior_source_ip by host
| where activity="powershell"
| eval time_difference=_time-prior_network_time
| where isnotnull(prior_network_time) AND time_difference>=0 AND time_difference<=600
| eval correlation="CORR-002 - Remote Network Logon Followed by PowerShell"
| eval risk=65
| eval severity="HIGH"
| eval powershell_time=_time
| convert ctime(prior_network_time) ctime(powershell_time)
| table host correlation severity risk prior_network_time powershell_time time_difference prior_account prior_source_ip
```

